<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050810"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HUD 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="// SYSTEM BOOT //"
            android:textSize="12sp"
            android:textColor="#5A9ACF"
            android:fontFamily="monospace"
            android:letterSpacing="0.3"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI AUTH"
            android:textSize="34sp"
            android:textColor="#00F0FF"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择 AI 助手模式"
            android:textSize="13sp"
            android:textColor="#6A8AAA"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- 状态 -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[ ... ] CHECKING"
            android:textSize="13sp"
            android:textColor="#05FFA1"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- 电脑端地址：点击修改 -->
        <TextView
            android:id="@+id/server_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SERVER: -"
            android:textSize="11sp"
            android:textColor="#5A9ACF"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cmd_box"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp" />


        <!-- 权限按钮 -->
        <Button
            android:id="@+id/btn_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GRANT OVERLAY"
            android:background="@drawable/btn_permission"
            android:textColor="#FFB800"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Codex 模式按钮 -->
        <Button
            android:id="@+id/btn_codex"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="CODEX"
            android:textSize="20sp"
            android:textColor="#00F0FF"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:background="@drawable/btn_codex"
            android:layout_marginBottom="12dp" />

        <!-- Work Buddy 模式按钮 -->
        <Button
            android:id="@+id/btn_workbuddy"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="WORK BUDDY"
            android:textSize="20sp"
            android:textColor="#D400FF"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:background="@drawable/btn_workbuddy"
            android:layout_marginBottom="24dp" />

        <!-- 停止按钮 -->
        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STOP SERVICE"
            android:background="@drawable/btn_stop"
            android:textColor="#FF2A6D"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- 说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="// 选择模式后，AI 执行命令时将弹出授权窗口"
            android:textSize="11sp"
            android:textColor="#4A6A8A"
            android:fontFamily="monospace"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</ScrollView>
